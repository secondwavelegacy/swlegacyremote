<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Halaman Percubaan</title>
    <style>
        body {
            background-color: #1e1e1e; /* Dark theme */
            color: #ffffff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        #chart {
            width: 100%;
            height: 500px;
            background-color: #2c2c2c;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #888;
            font-size: 24px;
        }
        button {
            padding: 10px 20px;
            margin: 10px 0;
            font-size: 16px;
        }
    </style>
</head>
<body>
    <h1>Halaman Percubaan</h1>
    <div id="chart">Chart Placeholder</div>
    <button id="loadDataBtn">Muat Data</button>

    <script>
        const loadDataBtn = document.getElementById('loadDataBtn');
        const chartDiv = document.getElementById('chart');

        loadDataBtn.addEventListener('click', () => {
            chartDiv.textContent = "Data dimuatkan!";
        });
    </script>
</body>
</html>
